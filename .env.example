# Copy to .env and fill in. Never commit the real .env file.

# ClickUp personal API token (Settings > Apps > API Token). Starts with pk_
CLICKUP_API_TOKEN=pk_your_token_here
# Workspace ID: run `python setup_fields.py --workspaces`
CLICKUP_TEAM_ID=
# The number in the Intake list's URL
CLICKUP_INTAKE_LIST_ID=
# Printed by `python setup_fields.py`
CLICKUP_AI_SUMMARY_FIELD_ID=
CLICKUP_AI_PRIORITY_FIELD_ID=
# Written automatically by `python register_webhook.py --endpoint ...`
CLICKUP_WEBHOOK_SECRET=

# Anthropic API key for the AI step (console at platform.claude.com)
ANTHROPIC_API_KEY=sk-ant-your_key_here
# claude-sonnet-5-5 by default: cheap and plenty for triage; use claude-opus-5-5 for harder text
LLM_MODEL=claude-sonnet-5-5

# Optional: comma-separated service types (must match the Service type dropdown)
# SERVICE_TYPES=Workspace setup,Automation,Integration / API,AI assistant,Consulting / other
# Optional: set to false to skip the comment and only fill the fields
# POST_COMMENT=true
PORT=8000
